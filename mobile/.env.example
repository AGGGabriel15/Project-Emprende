# Copia este archivo a .env.local. Solo valores públicos (los mismos NEXT_PUBLIC_* del web).
# Nunca pongas aquí la service role ni claves de Stripe.
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<clave anon/publishable>
# API del web (pagos, reembolsos, evidencias).
EXPO_PUBLIC_API_URL=https://catarina-market.vercel.app
