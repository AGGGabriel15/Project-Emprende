{
  "expo": {
    "name": "Catarina Market",
    "slug": "catarina-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catarinamarket",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FBF9",
    "ios": {
      "bundleIdentifier": "com.catarinamarket.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.catarinamarket.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1E7A4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E7A4C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Catarina Market usa tu ubicación para registrar entregas, ubicar tu negocio y llenar tu dirección."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Catarina Market necesita tus fotos para subir productos, evidencias y documentos.",
          "cameraPermission": "Catarina Market usa la cámara para fotos de productos, evidencias de entrega y la verificación de tu negocio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1E7A4C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c584196d-3b1c-41af-87d4-fffc164ca78b"
      }
    },
    "owner": "agggabriel15"
  }
}
