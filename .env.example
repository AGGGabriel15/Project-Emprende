# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Solo servidor (webhooks, seed). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Project Settings → Database → Connection string (Session pooler). Para npm run db:migrate.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
SEED_DEFAULT_PASSWORD=Catarina2026!

# --- Pagos ---
# "mock" fuerza la pasarela simulada aunque haya llaves de Stripe.
PAYMENTS_MODE=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Correo (opcional; sin llave solo se registra en consola) ---
RESEND_API_KEY=
EMAIL_FROM=Catarina Market <onboarding@resend.dev>

# --- Monitoreo (opcional) ---
NEXT_PUBLIC_SENTRY_DSN=
